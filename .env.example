PORT=3000

# MongoDB Atlas connection string.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/anify?retryWrites=true&w=majority
MONGODB_URI=

# Cloudflare R2 object storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anify-media

# Public URL for uploaded files.
# Use an R2 custom domain or public bucket URL, for example:
# https://media.yourdomain.com
R2_PUBLIC_URL=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email configuration (Gmail)
# Note: You must enable 2FA on your Google account and generate an App Password
# Go to: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=
