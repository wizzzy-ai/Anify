PORT=3000

# Application URL (used for email verification links)
APP_URL=http://localhost:3000

# JWT secret for token signing (generate a strong random string)
JWT_SECRET=

# MongoDB Atlas connection string.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/anify?retryWrites=true&w=majority
MONGODB_URI=

# Cloudflare R2 object storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anify-media

# Public URL for uploaded files.
# Use an R2 custom domain or public bucket URL, for example:
# https://media.yourdomain.com
R2_PUBLIC_URL=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email configuration
# For Gmail: enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=

# Paystack payment integration (for donations)
# Get your secret key from https://dashboard.paystack.co/#/settings/keys
PAYSTACK_SECRET_KEY=
BASE_URL=http://localhost:3000
