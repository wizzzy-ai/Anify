        "w": 1024,
        "h": 1024
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap');\n\n  .review-demo {\n    --background: #fff8fb;\n    --surface: #2d1322;\n    --surface-raised: #3a1a2b;\n    --field: #442033;\n    --primary: #f04f79;\n    --primary-strong: #d92f5e;\n    --accent: #ffb1c4;\n    --text-primary: #351925;\n    --text-secondary: #6b4f5d;\n    --text-tertiary: #876c79;\n    --on-surface: #fff7fa;\n    --on-surface-secondary: #f3cfda;\n    --on-surface-tertiary: #d8a9ba;\n    --border: rgba(97, 39, 63, 0.18);\n    --surface-border: rgba(255, 218, 229, 0.18);\n    --focus-ring: rgba(255, 177, 196, 0.86);\n    --button-text: #2c0f1c;\n    --shadow: rgba(49, 9, 26, 0.16);\n    min-height: 100%;\n    background: var(--background);\n    color: var(--text-primary);\n    font-family: 'Inter', sans-serif;\n  }\n\n  .review-demo .review-section {\n    max-width: 930px;\n    margin: 0 auto;\n    padding: 56px 28px 76px;\n  }\n\n  .review-demo .review-heading {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 20px;\n    margin-bottom: 22px;\n  }\n\n  .review-demo .review-heading-main {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n  }\n\n  .review-demo .review-heading-icon {\n    display: grid;\n    place-items: center;\n    width: 42px;\n    height: 42px;\n    flex: 0 0 auto;\n    margin-top: 2px;\n    border: 1px solid color-mix(in srgb, var(--primary) 35%, transparent);\n    border-radius: 14px;\n    background: color-mix(in srgb, var(--primary) 10%, var(--background));\n    color: var(--primary-strong);\n  }\n\n  .review-demo .review-heading-icon svg,\n  .review-demo .review-heading-icon i { width: 21px; height: 21px; }\n\n  .review-demo .eyebrow {\n    margin: 0 0 5px;\n    color: var(--primary-strong);\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .review-demo h2,\n  .review-demo h3,\n  .review-demo p { margin: 0; }\n\n  .review-demo .review-heading h2 {\n    color: var(--text-primary);\n    font-family: 'Outfit', sans-serif;\n    font-size: clamp(1.7rem, 3vw, 2.25rem);\n    font-weight: 900;\n    letter-spacing: -.04em;\n    line-height: 1.05;\n  }\n\n  .review-demo .review-heading-copy {\n    max-width: 520px;\n    margin-top: 8px;\n    color: var(--text-secondary);\n    font-size: .88rem;\n    line-height: 1.55;\n  }\n\n  .review-demo .review-count {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    flex: 0 0 auto;\n    padding: 10px 13px;\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    background: color-mix(in srgb, var(--background) 74%, var(--primary) 26%);\n    color: var(--text-secondary);\n    font-size: .75rem;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  .review-demo .review-count strong { color: var(--text-primary); font-weight: 800; }\n  .review-demo .review-count svg,\n  .review-demo .review-count i { width: 15px; height: 15px; color: var(--primary-strong); }\n\n  .review-demo .composer-card {\n    position: relative;\n    overflow: hidden;\n    padding: 24px;\n    border: 1px solid var(--surface-border);\n    border-radius: 22px;\n    background: var(--surface);\n    box-shadow: 0 24px 58px var(--shadow);\n  }\n\n  .review-demo .composer-card::before {\n    position: absolute;\n    top: 0;\n    left: 8%;\n    width: 84%;\n    height: 2px;\n    background: linear-gradient(90deg, transparent, var(--primary), transparent);\n    content: '';\n    opacity: .82;\n  }\n\n  .review-demo .composer-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    padding-bottom: 20px;\n    border-bottom: 1px solid var(--surface-border);\n  }\n\n  .review-demo .author {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    min-width: 0;\n  }\n\n  .review-demo .avatar {\n    display: grid;\n    place-items: center;\n    width: 44px;\n    height: 44px;\n    flex: 0 0 auto;\n    border: 2px solid color-mix(in srgb, var(--primary) 44%, var(--surface));\n    border-radius: 50%;\n    background: var(--surface-raised);\n    color: var(--accent);\n    font-family: 'Outfit', sans-serif;\n    font-size: 15px;\n    font-weight: 900;\n  }\n\n  .review-demo .composer-title {\n    color: var(--on-surface);\n    font-family: 'Outfit', sans-serif;\n    font-size: 1.05rem;\n    font-weight: 800;\n    letter-spacing: -.02em;\n  }\n\n  .review-demo .composer-helper {\n    margin-top: 3px;\n    color: var(--on-surface-tertiary);\n    font-size: .75rem;\n    line-height: 1.4;\n  }\n\n  .review-demo .draft-state {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    color: var(--on-surface-secondary);\n    font-size: .72rem;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  .review-demo .draft-state-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--primary);\n    box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 16%, transparent);\n  }\n\n  .review-demo .composer-grid {\n    display: grid;\n    grid-template-columns: minmax(225px, .76fr) minmax(0, 1.6fr);\n    gap: 22px;\n    padding: 22px 0;\n  }\n\n  .review-demo .rating-panel {\n    padding: 18px;\n    border: 1px solid var(--surface-border);\n    border-radius: 16px;\n    background: var(--surface-raised);\n  }\n\n  .review-demo .field-label {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--on-surface);\n    font-size: .78rem;\n    font-weight: 800;\n    letter-spacing: .01em;\n  }\n\n  .review-demo .optional-badge {\n    padding: 4px 7px;\n    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);\n    border-radius: 7px;\n    color: var(--accent);\n    font-size: .62rem;\n    font-weight: 800;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n  }\n\n  .review-demo .field-helper {\n    margin-top: 7px;\n    color: var(--on-surface-tertiary);\n    font-size: .72rem;\n    line-height: 1.5;\n  }\n\n  .review-demo .rating-stars {\n    display: flex;\n    gap: 3px;\n    margin: 13px 0 10px;\n  }\n\n  .review-demo .rating-star {\n    display: grid;\n    place-items: center;\n    width: 44px;\n    height: 44px;\n    padding: 0;\n    border: 1px solid transparent;\n    border-radius: 12px;\n    background: transparent;\n    color: var(--on-surface-tertiary);\n    cursor: pointer;\n  }\n\n  .review-demo .rating-star:hover { background: color-mix(in srgb, var(--primary) 13%, transparent); color: var(--accent); }\n  .review-demo .rating-star:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }\n  .review-demo .rating-star[data-selected='true'] { color: var(--primary); }\n  .review-demo .rating-star[data-selected='true'] svg { fill: currentColor; }\n  .review-demo .rating-star svg,\n  .review-demo .rating-star i { width: 21px; height: 21px; stroke-width: 2; }\n\n  .review-demo .rating-readout {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    color: var(--on-surface);\n    font-family: 'Outfit', sans-serif;\n    font-size: 1.25rem;\n    font-weight: 900;\n  }\n\n  .review-demo .rating-readout span { color: var(--on-surface-tertiary); font-family: 'Inter', sans-serif; font-size: .72rem; font-weight: 700; }\n\n  .review-demo .rating-status {\n    min-height: 32px;\n    margin-top: 12px;\n    padding: 8px 10px;\n    border-left: 2px solid var(--primary);\n    background: color-mix(in srgb, var(--primary) 9%, transparent);\n    color: var(--on-surface-secondary);\n    font-size: .7rem;\n    line-height: 1.45;\n  }\n\n  .review-demo .review-field { min-width: 0; }\n  .review-demo .review-field .field-helper { margin-bottom: 8px; }\n\n  .review-demo .textarea-wrap { position: relative; }\n\n  .review-demo textarea {\n    display: block;\n    width: 100%;\n    min-height: 140px;\n    padding: 15px 16px 32px;\n    resize: vertical;\n    border: 1px solid var(--surface-border);\n    border-radius: 14px;\n    outline: none;\n    background: var(--field);\n    color: var(--on-surface);\n    font: inherit;\n    font-size: .84rem;\n    line-height: 1.6;\n  }\n\n  .review-demo textarea::placeholder { color: var(--on-surface-tertiary); opacity: 1; }\n  .review-demo textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 25%, transparent); }\n\n  .review-demo .character-count {\n    position: absolute;\n    right: 12px;\n    bottom: 10px;\n    color: var(--on-surface-tertiary);\n    font-family: 'Inter', sans-serif;\n    font-size: .66rem;\n    font-weight: 700;\n  }\n\n  .review-demo .composer-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    padding-top: 18px;\n    border-top: 1px solid var(--surface-border);\n  }\n\n  .review-demo .privacy-note {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--on-surface-secondary);\n    font-size: .74rem;\n    font-weight: 700;\n  }\n\n  .review-demo .privacy-note svg,\n  .review-demo .privacy-note i { width: 17px; height: 17px; color: var(--accent); }\n\n  .review-demo .post-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-height: 44px;\n    padding: 0 18px;\n    border: 1px solid var(--primary);\n    border-radius: 12px;\n    background: var(--primary);\n    color: var(--button-text);\n    cursor: pointer;\n    font: inherit;\n    font-size: .78rem;\n    font-weight: 900;\n    box-shadow: 0 10px 25px color-mix(in srgb, var(--primary) 22%, transparent);\n  }\n\n  .review-demo .post-button:hover { background: var(--primary-strong); border-color: var(--primary-strong); }\n  .review-demo .post-button:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 3px; }\n  .review-demo .post-button:active { transform: translateY(1px); }\n  .review-demo .post-button svg,\n  .review-demo .post-button i { width: 16px; height: 16px; }\n\n  .review-demo .post-status {\n    min-height: 18px;\n    margin-top: 10px;\n    color: var(--on-surface-tertiary);\n    font-size: .7rem;\n    text-align: right;\n  }\n\n  .review-demo .comments-heading {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 18px;\n    margin: 34px 0 14px;\n  }\n\n  .review-demo .comments-heading h3 {\n    color: var(--text-primary);\n    font-family: 'Outfit', sans-serif;\n    font-size: 1.12rem;\n    font-weight: 900;\n    letter-spacing: -.02em;\n  }\n\n  .review-demo .comments-heading p { color: var(--text-secondary); font-size: .75rem; }\n\n  .review-demo .comment-list { display: grid; gap: 11px; }\n\n  .review-demo .comment-row {\n    display: flex;\n    align-items: flex-start;\n    gap: 13px;\n    padding: 17px 18px;\n    border: 1px solid var(--border);\n    border-radius: 16px;\n    background: color-mix(in srgb, var(--background) 88%, var(--primary) 12%);\n  }\n\n  .review-demo .comment-row .avatar { width: 38px; height: 38px; font-size: 12px; }\n  .review-demo .comment-content { min-width: 0; flex: 1; }\n\n  .review-demo .comment-meta {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 7px 10px;\n  }\n\n  .review-demo .comment-name { color: var(--text-primary); font-size: .8rem; font-weight: 800; }\n  .review-demo .comment-time { color: var(--text-tertiary); font-size: .7rem; }\n\n  .review-demo .rating-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 4px 7px;\n    border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);\n    border-radius: 8px;\n    background: color-mix(in srgb, var(--primary) 10%, var(--background));\n    color: var(--primary-strong);\n    font-size: .67rem;\n    font-weight: 900;\n  }\n\n  .review-demo .rating-chip svg,\n  .review-demo .rating-chip i { width: 12px; height: 12px; fill: currentColor; }\n  .review-demo .comment-copy { margin-top: 8px; color: var(--text-secondary); font-size: .82rem; line-height: 1.6; }\n\n  .review-demo .comment-actions { display: flex; align-items: center; gap: 15px; margin-top: 11px; }\n  .review-demo .comment-action {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    min-height: 32px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: var(--text-tertiary);\n    cursor: pointer;\n    font: inherit;\n    font-size: .68rem;\n    font-weight: 700;\n  }\n  .review-demo .comment-action:hover { color: var(--primary-strong); }\n  .review-demo .comment-action:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 4px; border-radius: 5px; }\n  .review-demo .comment-action svg,\n  .review-demo .comment-action i { width: 14px; height: 14px; }\n\n  @media (max-width: 680px) {\n    .review-demo .review-section { padding: 36px 16px 52px; }\n    .review-demo .review-heading { display: block; }\n    .review-demo .review-count { margin: 16px 0 0 56px; }\n    .review-demo .composer-card { padding: 18px; border-radius: 18px; }\n    .review-demo .composer-top { align-items: flex-start; }\n    .review-demo .draft-state { display: none; }\n    .review-demo .composer-grid { grid-template-columns: 1fr; gap: 14px; padding: 18px 0; }\n    .review-demo .rating-panel { padding: 15px; }\n    .review-demo .composer-footer { align-items: stretch; flex-direction: column; gap: 13px; }\n    .review-demo .post-button { width: 100%; }\n    .review-demo .comment-row { padding: 14px; }\n  }\n</style>\n<div class=\"review-demo\" data-kid=\"1\">\n    <section aria-labelledby=\"reviews-title\" class=\"review-section\" data-kid=\"1-1\">\n        <header class=\"review-heading\" data-kid=\"1-1-1\">\n            <div class=\"review-heading-main\" data-kid=\"1-1-1-1\">\n                <div aria-hidden=\"true\" class=\"review-heading-icon\" data-kid=\"1-1-1-1-1\">\n                    <i data-kid=\"1-1-1-1-1-1\" data-lucide=\"message-circle\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"eyebrow\" data-kid=\"1-1-1-1-2-1\">\n                        Community notes\n                    </p>\n                    <h2 data-kid=\"1-1-1-1-2-2\" id=\"reviews-title\">\n                        Reviews & Comments\n                    </h2>\n                    <p class=\"review-heading-copy\" data-kid=\"1-1-1-1-2-3\">\n                        Share a rating or a quick take with the community. Your perspective helps other fans find their next favorite.\n                    </p>\n                </div>\n            </div>\n            <div class=\"review-count\" data-kid=\"1-1-1-2\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-1-2-1\" data-lucide=\"users\">\n                </i>\n                <strong data-dynamic=\"true\" data-kid=\"1-1-1-2-2\" data-name=\"community review count text\" data-reason=\"number replaced by review aggregation script\">\n                    128\n                </strong>\n                community reviews\n            </div>\n        </header>\n        <form aria-label=\"Write a review\" class=\"composer-card\" data-kid=\"1-1-2\" id=\"review-form\" onsubmit=\"return false\">\n            <div class=\"composer-top\" data-kid=\"1-1-2-1\">\n                <div class=\"author\" data-kid=\"1-1-2-1-1\">\n                    <div aria-hidden=\"true\" class=\"avatar\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1\" data-name=\"user avatar initials\" data-reason=\"text content derived from user profile session data\">\n                        AM\n                    </div>\n                    <div data-kid=\"1-1-2-1-1-2\">\n                        <h3 class=\"composer-title\" data-kid=\"1-1-2-1-1-2-1\">\n                            Share your take\n                        </h3>\n                        <p class=\"composer-helper\" data-kid=\"1-1-2-1-1-2-2\">\n                            Your review will be public on this title.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"draft-state\" data-kid=\"1-1-2-1-2\">\n                    <span aria-hidden=\"true\" class=\"draft-state-dot\" data-kid=\"1-1-2-1-2-1\">\n                    </span>\n                    Draft ready\n                </div>\n            </div>\n            <div class=\"composer-grid\" data-kid=\"1-1-2-2\">\n                <div class=\"rating-panel\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"field-label\" data-kid=\"1-1-2-2-1-1\">\n                        Rate this title\n                        <span class=\"optional-badge\" data-kid=\"1-1-2-2-1-1-1\">\n                            Optional\n                        </span>\n                    </div>\n                    <p class=\"field-helper\" data-kid=\"1-1-2-2-1-2\">\n                        Tap a star to add your overall feeling.\n                    </p>\n                    <div aria-label=\"Rate this title from 1 to 5 stars\" class=\"rating-stars\" data-kid=\"1-1-2-2-1-3\" data-name=\"rating star selector group\" id=\"rating-selector\" role=\"group\">\n                        <button aria-label=\"1 star\" aria-pressed=\"true\" class=\"rating-star\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"one star button\" data-rating=\"1\" data-reason=\"selected state and aria-pressed toggled by script\" data-selected=\"true\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-3-1-1\" data-lucide=\"star\">\n                            </i>\n                        </button>\n                        <button aria-label=\"2 stars\" aria-pressed=\"true\" class=\"rating-star\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"two star button\" data-rating=\"2\" data-reason=\"selected state and aria-pressed toggled by script\" data-selected=\"true\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-3-2-1\" data-lucide=\"star\">\n                            </i>\n                        </button>\n                        <button aria-label=\"3 stars\" aria-pressed=\"true\" class=\"rating-star\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-3\" data-name=\"three star button\" data-rating=\"3\" data-reason=\"selected state and aria-pressed toggled by script\" data-selected=\"true\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-3-3-1\" data-lucide=\"star\">\n                            </i>\n                        </button>\n                        <button aria-label=\"4 stars\" aria-pressed=\"true\" class=\"rating-star\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-4\" data-name=\"four star button\" data-rating=\"4\" data-reason=\"selected state and aria-pressed toggled by script\" data-selected=\"true\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-3-4-1\" data-lucide=\"star\">\n                            </i>\n                        </button>\n                        <button aria-label=\"5 stars\" aria-pressed=\"false\" class=\"rating-star\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-5\" data-name=\"five star button\" data-rating=\"5\" data-reason=\"selected state and aria-pressed toggled by script\" data-selected=\"false\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-3-5-1\" data-lucide=\"star\">\n                            </i>\n                        </button>\n                    </div>\n                    <div aria-live=\"polite\" class=\"rating-readout\" data-kid=\"1-1-2-2-1-4\">\n                        <strong data-dynamic=\"true\" data-kid=\"1-1-2-2-1-4-1\" data-name=\"current rating numerical display\" data-reason=\"text content replaced by rating selection script\" id=\"rating-value\">\n                            4 / 5\n                        </strong>\n                        <span data-kid=\"1-1-2-2-1-4-2\">\n                            selected rating\n                        </span>\n                    </div>\n                    <div aria-live=\"polite\" class=\"rating-status\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-5\" data-name=\"rating status message\" data-reason=\"text content updated based on selected rating by script\" id=\"rating-status\">\n                        Great choice — this title is getting a strong recommendation.\n                    </div>\n                </div>\n                <div class=\"review-field\" data-kid=\"1-1-2-2-2\">\n                    <label class=\"field-label\" data-kid=\"1-1-2-2-2-1\" for=\"comment-input\">\n                        Your review\n                    </label>\n                    <p class=\"field-helper\" data-kid=\"1-1-2-2-2-2\" id=\"review-helper\">\n                        Keep it thoughtful and spoiler-free for everyone.\n                    </p>\n                    <div class=\"textarea-wrap\" data-kid=\"1-1-2-2-2-3\">\n                        <textarea aria-describedby=\"review-helper review-counter\" data-kid=\"1-1-2-2-2-3-1\" id=\"comment-input\" maxlength=\"280\" placeholder=\"What stood out to you?\"></textarea>\n                        <span class=\"character-count\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"character counter display\" data-reason=\"text content updated on input by script\" id=\"review-counter\">\n                            0 / 280\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"composer-footer\" data-kid=\"1-1-2-3\">\n                <div class=\"privacy-note\" data-kid=\"1-1-2-3-1\">\n                    <i aria-hidden=\"true\" data-kid=\"1-1-2-3-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                    <span data-kid=\"1-1-2-3-1-2\">\n                        Visible to the community\n                    </span>\n                </div>\n                <button class=\"post-button\" data-kid=\"1-1-2-3-2\" id=\"post-review\" type=\"button\">\n                    <i aria-hidden=\"true\" data-kid=\"1-1-2-3-2-1\" data-lucide=\"send\">\n                    </i>\n                    Post review\n                </button>\n            </div>\n            <div aria-live=\"polite\" class=\"post-status\" data-dynamic=\"true\" data-kid=\"1-1-2-4\" data-name=\"post status message\" data-reason=\"text content updated by script based on user interaction\" id=\"post-status\">\n                Choose a rating, then add a few words.\n            </div>\n        </form>\n        <div class=\"comments-heading\" data-kid=\"1-1-3\">\n            <h3 data-kid=\"1-1-3-1\">\n                What the community is saying\n            </h3>\n            <p data-kid=\"1-1-3-2\">\n                Latest thoughtful takes\n            </p>\n        </div>\n        <div aria-label=\"Community reviews\" class=\"comment-list\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"community review list container\" data-reason=\"children injected by review fetching script\">\n            <article class=\"comment-row\" data-kid=\"1-1-4-1\">\n                <div aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-4-1-1\">\n                    JR\n                </div>\n                <div class=\"comment-content\" data-kid=\"1-1-4-1-2\">\n                    <div class=\"comment-meta\" data-kid=\"1-1-4-1-2-1\">\n                        <span class=\"comment-name\" data-kid=\"1-1-4-1-2-1-1\">\n                            JunoRin\n                        </span>\n                        <span class=\"comment-time\" data-kid=\"1-1-4-1-2-1-2\">\n                            2h ago\n                        </span>\n                        <span class=\"rating-chip\" data-kid=\"1-1-4-1-2-1-3\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-4-1-2-1-3-1\" data-lucide=\"star\">\n                            </i>\n                            4.5 / 5\n                        </span>\n                    </div>\n                    <p class=\"comment-copy\" data-kid=\"1-1-4-1-2-2\">\n                        The pacing finally clicks here — the quiet character moments make the big set pieces land so much harder.\n                    </p>\n                    <div class=\"comment-actions\" data-kid=\"1-1-4-1-2-3\">\n                        <button aria-label=\"Like JunoRin's review\" class=\"comment-action\" data-kid=\"1-1-4-1-2-3-1\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-4-1-2-3-1-1\" data-lucide=\"heart\">\n                            </i>\n                            12 likes\n                        </button>\n                        <button aria-label=\"Reply to JunoRin\" class=\"comment-action\" data-kid=\"1-1-4-1-2-3-2\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-4-1-2-3-2-1\" data-lucide=\"message-circle\">\n                            </i>\n                            Reply\n                        </button>\n                    </div>\n                </div>\n            </article>\n            <article class=\"comment-row\" data-kid=\"1-1-4-2\">\n                <div aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-4-2-1\">\n                    KS\n                </div>\n                <div class=\"comment-content\" data-kid=\"1-1-4-2-2\">\n                    <div class=\"comment-meta\" data-kid=\"1-1-4-2-2-1\">\n                        <span class=\"comment-name\" data-kid=\"1-1-4-2-2-1-1\">\n                            KaitoSora\n                        </span>\n                        <span class=\"comment-time\" data-kid=\"1-1-4-2-2-1-2\">\n                            Yesterday\n                        </span>\n                        <span class=\"rating-chip\" data-kid=\"1-1-4-2-2-1-3\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-4-2-2-1-3-1\" data-lucide=\"star\">\n                            </i>\n                            5 / 5\n                        </span>\n                    </div>\n                    <p class=\"comment-copy\" data-kid=\"1-1-4-2-2-2\">\n                        A warm, surprisingly funny watch. The soundtrack is doing a lot of work in the best possible way.\n                    </p>\n                    <div class=\"comment-actions\" data-kid=\"1-1-4-2-2-3\">\n                        <button aria-label=\"Like KaitoSora's review\" class=\"comment-action\" data-kid=\"1-1-4-2-2-3-1\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-4-2-2-3-1-1\" data-lucide=\"heart\">\n                            </i>\n                            8 likes\n                        </button>\n                        <button aria-label=\"Reply to KaitoSora\" class=\"comment-action\" data-kid=\"1-1-4-2-2-3-2\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-1-4-2-2-3-2-1\" data-lucide=\"message-circle\">\n                            </i>\n                            Reply\n                        </button>\n                    </div>\n                </div>\n            </article>\n        </div>\n    </section>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js\">\n</script>\n<script>\n    (() => {\n    const stars = [...document.querySelectorAll('.rating-star')];\n    const ratingValue = document.getElementById('rating-value');\n    const ratingStatus = document.getElementById('rating-status');\n    const reviewInput = document.getElementById('comment-input');\n    const counter = document.getElementById('review-counter');\n    const postButton = document.getElementById('post-review');\n    const postStatus = document.getElementById('post-status');\n    let rating = 4;\n\n    const statusCopy = {\n      1: 'A softer score — thanks for sharing an honest take.',\n      2: 'A mixed feeling — your context will help other viewers.',\n      3: 'A balanced score — tell the community what worked for you.',\n      4: 'Great choice — this title is getting a strong recommendation.',\n      5: 'A full recommendation — your enthusiasm is welcome here.'\n    };\n\n    function renderRating(nextRating) {\n      rating = nextRating;\n      stars.forEach((star) => {\n        const value = Number(star.dataset.rating);\n        const selected = value <= rating;\n        star.dataset.selected = String(selected);\n        star.setAttribute('aria-pressed', String(selected));\n      });\n      ratingValue.textContent = `${rating} / 5`;\n      ratingStatus.textContent = statusCopy[rating];\n      postStatus.textContent = reviewInput.value.trim() ? 'Your draft is ready to post.' : 'Choose a rating, then add a few words.';\n    }\n\n    stars.forEach((star) => star.addEventListener('click', () => renderRating(Number(star.dataset.rating))));\n    reviewInput.addEventListener('input', () => {\n      counter.textContent = `${reviewInput.value.length} / 280`;\n      postStatus.textContent = reviewInput.value.trim() ? 'Your draft is ready to post.' : 'Choose a rating, then add a few words.';\n    });\n    postButton.addEventListener('click', () => {\n      postStatus.textContent = reviewInput.value.trim() ? 'Review draft saved — ready to share.' : 'Add a few words before posting your review.';\n      reviewInput.focus();\n    });\n\n    if (window.lucide) window.lucide.createIcons();\n    renderRating(rating);\n  })();\n</script>\n",
